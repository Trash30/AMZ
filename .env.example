# URL de la page promo Amazon a surveiller
TARGET_URL=https://www.amazon.fr/promotion/psp/A26013IELTKPDW

# Webhook Discord (REQUIS) — sans valeur, aucune notification n'est envoyee
DISCORD_WEBHOOK_URL=

# Intervalle entre deux cycles de scraping (secondes)
INTERVAL_SECONDS=5

# Chemin du fichier d'etat JSON
STATE_FILE=state.json

# Nombre de scans avant recyclage du navigateur (anti-fuite memoire)
BROWSER_RECYCLE_INTERVAL=150

# Nombre de scans consecutifs d'absence avant suppression d'un ASIN
GRACE_PERIOD_SCANS=5

# Chemin vers Chromium systeme (si OS non supporte par Playwright)
# Ubuntu : /usr/bin/chromium
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
